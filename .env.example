# .env.example を .env にコピーして使います（値は KEY=value のリテラルのみ）。
# プロセス環境変数が .env より優先されます。
# 開始ポート（5000 使用中なら 5001/5002…へ自動回避）
# 公開トンネル（Cloudflare Tunnel: plan.wawa-app.me）は 5002 を見ているため、
# 公開する場合は 5002 で起動すること（既定の優先順で 5002 が先頭）。
# QUADTECHO_PORT=5002
# SQLite のロック待ち上限（秒）。自動保存と掲示板が同時に書き込むための余裕。
# QUADTECHO_DB_TIMEOUT=10.0
